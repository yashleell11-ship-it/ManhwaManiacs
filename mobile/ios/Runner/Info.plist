<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ManhwaManiacs</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>ManhwaManiacs</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!--
		Purpose strings. iOS does not warn about a missing one: it kills the
		process the instant the matching framework is touched, which on a
		sideloaded build looks identical to an expired signing certificate.
		Both keys below cover code that is COMPILED INTO the binary by
		file_picker 8.3.7 even though the app's own Dart never reaches it
		(lib/features/settings/screens/backup_screen.dart calls pickFiles()
		with the default FileType.any, which is the document-picker path).
		They are here so that a future FileType.audio/image call, or a
		file_picker upgrade, cannot turn into an unexplainable crash on a
		phone nobody can attach a debugger to.
	-->
	<key>NSAppleMusicUsageDescription</key>
	<string>ManhwaManiacs only needs your media library if you pick an audio file from it. It never reads your library otherwise.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>ManhwaManiacs only needs your photo library if you pick an image from it, for example when restoring a backup. It never reads your photos otherwise.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!--
		Novel narration. A chapter is about thirteen minutes of listening, and
		the whole point is that the phone can go in a pocket. Without this
		mode iOS suspends the process the moment the screen locks or another
		app comes forward, so the voice stops within a second and the
		follow-along highlight freezes on the last sentence. just_audio already
		puts the session in the playback category (lib/main.dart configures it
		for speech); the category alone is not enough without the mode.
		A sideloaded build needs no entitlement for it.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!--
		On-device chapter store (1c-M3, spec Sec3b). iOS gives a sideloaded app
		no safe user-chosen download folder (a security-scoped bookmark goes
		stale across the 7-day re-sign this build lives under), so instead of a
		folder picker the blob tree lives under Documents/mm-store/blobs and is
		made VISIBLE: with both keys set, it appears under
		Files -> On My iPhone -> ManhwaManiacs, letting the owner browse, copy
		and delete downloaded chapters by hand. The sqflite index stays in
		Application Support (not exposed here) so a user deleting files this
		way can only ever orphan a blob, never corrupt the index.
	-->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
